{
  "name": "hotel-crm-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:ws": "tsx server.ts",
    "dev:workers": "tsx src/workers/start.ts",
    "dev:api": "fastify start -w src/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seeds/index.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:api": "vitest run --config vitest.config.api.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^10.0.0",
    "@react-pdf/renderer": "^3.4.0",
    "@sentry/nextjs": "^7.110.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.28.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^5.4.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.0",
    "jose": "^5.2.0",
    "next": "14.2.0",
    "next-pwa": "^5.6.0",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-joyride": "^2.8.0",
    "recharts": "^2.12.0",
    "resend": "^3.2.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "swagger-ui-react": "^5.32.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  }
}
