# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_crm

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=CRM Hotel <noreply@yourdomain.com>

# Redis (BullMQ + Socket.io)
REDIS_URL=redis://localhost:6379

# Storage (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hotel-crm

# Monitoring (Sentry — https://sentry.io)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# App
NODE_ENV=development
PORT=3000
HOSTNAME=localhost
